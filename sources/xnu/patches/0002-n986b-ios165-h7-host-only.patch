+/* The H4 gate pins the whole physical MiB. This independently checks the
+ * HFS+ volume header on the same read-only physical copy path. */
+static int
+h7_probe_header(struct b2l_ro_device *candidate)
+{
+    uint8_t sector[B2L_RO_STORE_SECTOR], digest[32];
+    SHA256_CTX sha;
+    int error = b2l_ro_device_read(candidate, 1024, sector, sizeof(sector),
+                                   ro_physical_read, NULL);
+    if (error) return error;
+    SHA256_Init(&sha);
+    SHA256_Update(&sha, sector, sizeof(sector));
+    SHA256_Final(digest, &sha);
+    if (memcmp(digest, h7_header_sector_sha256, 32) ||
+        sector[0] != 'H' || sector[1] != '+' ||
+        sector[2] != 0 || sector[3] != 4 ||
+        sector[4] != 0x80 || sector[5] != 0 ||
+        sector[6] != 1 || sector[7] != 0 ||
+        sector[12] != 0 || sector[13] != 0 ||
+        sector[14] != 0 || sector[15] != 0)
+        return EIO;
+    return 0;
+}
+
+/* Only the verified, HFS-header-pinned, H6-vnode-tested dynamic bdev can
+ * become the diagnostic root. No md0 alias and no static major number. */
+int
+b2l_ro_store_h7_rootdev(dev_t *out)
+{
+    if (!out || !rodev.registered || bmajor < 0 ||
+        !h5_probe_passed || !h6_probe_passed || !h7_header_passed ||
+        rodev.store.image_kind != B2L_RO_KIND_DIAGNOSTIC ||
+        rodev.store.length != B2L_RO_STORE_MAX_DIAGNOSTIC ||
+        memcmp(rodev.store.image_sha256, h7_full_sha256, 32)) return ENXIO;
+    *out = makedev(bmajor, 0);
+    return 0;
+}
+
+int
+b2l_ro_store_h7_mount_begin(dev_t dev)
+{
+    dev_t verified;
+    if (b2l_ro_store_h7_rootdev(&verified) || dev != verified ||
+        h7_strategy_writes != 0 || ro_open(dev, FWRITE, S_IFBLK, NULL) != EROFS)
+        return EROFS;
+    h7_mount_passed = 0;
+    h7_mount_reads_before = h7_strategy_reads;
+    return 0;
+}
+
+int
+b2l_ro_store_h7_mount_end(dev_t dev, int mount_error)
+{
+    dev_t verified;
+    if (mount_error) return mount_error;
+    if (b2l_ro_store_h7_rootdev(&verified) ||
