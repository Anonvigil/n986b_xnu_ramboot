diff -urN '--exclude=BUILD' '--exclude=.git' '--exclude=__pycache__' a/bsd/b2l_ro_device.c b/bsd/b2l_ro_device.c
--- a/bsd/b2l_ro_device.c	1970-01-01 09:00:00.000000000 +0900
+++ b/bsd/b2l_ro_device.c	2026-11-09 15:27:52.573329241 +0900
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#include "b2l_ro_device.h"
+#include <sys/errno.h>
+#include <libkern/libkern.h>
+
+int b2l_ro_device_init(struct b2l_ro_device *dev, const void *property,
+                       size_t length, const struct b2l_ro_proof *proof)
+{
+    struct b2l_ro_store s;
+    if (dev) memset(dev, 0, sizeof(*dev));
+    if (!dev || !proof || !proof->efi_reserved_owner_confirmed ||
+        !proof->read_only_copy_window_confirmed ||
+        b2l_ro_store_decode(property, length, &s) != 0 ||
+        proof->observed_reservation_tag != s.reservation_tag ||
+        memcmp(proof->observed_image_sha256, s.image_sha256, 32) != 0)
+        return EINVAL;
+    memset(dev, 0, sizeof(*dev));
+    dev->store = s;
+    dev->registered = 1;
+    return 0;
+}
+
+int b2l_ro_device_read(struct b2l_ro_device *dev, uint64_t offset,
+                       void *destination, size_t length,
+                       b2l_ro_phys_read read_phys, void *ctx)
+{
+    uint64_t pa;
+    uint8_t *dst = destination;
+    if (!dev || !dev->registered || !destination || !read_phys ||
+        b2l_ro_store_span(&dev->store, offset, length, &pa)) return EINVAL;
+    while (length) {
+        size_t page_left = B2L_RO_STORE_PAGE - (size_t)(pa & (B2L_RO_STORE_PAGE - 1U));
+        size_t n = length < page_left ? length : page_left;
+        int error = read_phys(ctx, pa, dst, n);
+        if (error) return error;
+        pa += n;
+        dst += n;
+        length -= n;
+    }
+    return 0;
+}
+
+int b2l_ro_device_query(const struct b2l_ro_device *dev,
+                        enum b2l_ro_query query, uint64_t *answer)
+{
+    if (!dev || !dev->registered || !answer) return EINVAL;
+    switch (query) {
+    case B2L_RO_QUERY_SECTOR_SIZE: *answer = B2L_RO_STORE_SECTOR; return 0;
+    case B2L_RO_QUERY_PHYSICAL_BLOCK_SIZE: *answer = B2L_RO_STORE_PAGE; return 0;
+    case B2L_RO_QUERY_BLOCK_COUNT:
+        *answer = dev->store.length / B2L_RO_STORE_SECTOR; return 0;
+    case B2L_RO_QUERY_WRITABLE: *answer = 0; return 0;
+    case B2L_RO_QUERY_MAX_READ_BLOCKS:
+        *answer = B2L_RO_STORE_MAX_DIAGNOSTIC / B2L_RO_STORE_SECTOR; return 0;
+    case B2L_RO_QUERY_MAX_WRITE_BLOCKS: *answer = 0; return 0;
+    default: return EROFS;
+    }
+}
diff -urN '--exclude=BUILD' '--exclude=.git' '--exclude=__pycache__' a/bsd/b2l_ro_device.h b/bsd/b2l_ro_device.h
--- a/bsd/b2l_ro_device.h	1970-01-01 09:00:00.000000000 +0900
+++ b/bsd/b2l_ro_device.h	2026-11-09 15:27:52.572715628 +0900
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef B2L_RO_DEVICE_H
+#define B2L_RO_DEVICE_H
+#include "b2l_ro_store.h"
+
+struct b2l_ro_proof {
+    uint64_t observed_reservation_tag;
+    uint8_t observed_image_sha256[32];
+    int efi_reserved_owner_confirmed;
+    int read_only_copy_window_confirmed;
+};
+
+struct b2l_ro_device {
+    struct b2l_ro_store store;
+    int registered;
+};
+
+/* The supplied proof must originate outside the DT bytes. A caller is not
+ * allowed to mark an unobserved digest or EFI descriptor as verified. */
+int b2l_ro_device_init(struct b2l_ro_device *dev, const void *dt_property,
+                       size_t property_length, const struct b2l_ro_proof *proof);
+
+/* Each callback invocation remains within one 4 KiB physical page. */
+typedef int (*b2l_ro_phys_read)(void *ctx, uint64_t source_pa,
+                                void *destination, size_t bytes);
+int b2l_ro_device_read(struct b2l_ro_device *dev, uint64_t offset,
+                       void *destination, size_t length,
+                       b2l_ro_phys_read read_phys, void *ctx);
+
+enum b2l_ro_query {
+    B2L_RO_QUERY_SECTOR_SIZE,
+    B2L_RO_QUERY_PHYSICAL_BLOCK_SIZE,
+    B2L_RO_QUERY_BLOCK_COUNT,
+    B2L_RO_QUERY_WRITABLE,
+    B2L_RO_QUERY_MAX_READ_BLOCKS,
+    B2L_RO_QUERY_MAX_WRITE_BLOCKS
+};
+int b2l_ro_device_query(const struct b2l_ro_device *dev,
+                        enum b2l_ro_query query, uint64_t *answer);
+
+#endif
diff -urN '--exclude=BUILD' '--exclude=.git' '--exclude=__pycache__' a/bsd/b2l_ro_store.c b/bsd/b2l_ro_store.c
--- a/bsd/b2l_ro_store.c	1970-01-01 09:00:00.000000000 +0900
+++ b/bsd/b2l_ro_store.c	2026-11-09 15:15:44.916204694 +0900
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#include "b2l_ro_store.h"
+#include <sys/errno.h>
+#include <libkern/libkern.h>
+
+static const uint8_t magic[8] = { 'B', '2', 'L', 'R', 'O', 'V', '1', 0 };
+
+static uint16_t le16(const uint8_t *p)
+{ return (uint16_t)p[0] | (uint16_t)((uint16_t)p[1] << 8); }
+static uint32_t le32(const uint8_t *p)
+{ return (uint32_t)le16(p) | ((uint32_t)le16(p + 2) << 16); }
+static uint64_t le64(const uint8_t *p)
+{ return (uint64_t)le32(p) | ((uint64_t)le32(p + 4) << 32); }
+static void put16(uint8_t *p, uint16_t v)
+{ p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); }
+static void put32(uint8_t *p, uint32_t v)
+{ put16(p, (uint16_t)v); put16(p + 2, (uint16_t)(v >> 16)); }
+static void put64(uint8_t *p, uint64_t v)
+{ put32(p, (uint32_t)v); put32(p + 4, (uint32_t)(v >> 32)); }
+
+int b2l_ro_store_geometry(const struct b2l_ro_store *s)
+{
+    uint8_t digest_or = 0;
+    if (!s || s->reservation_tag == 0 ||
+        (s->base & (B2L_RO_STORE_PAGE - 1U)) != 0 ||
+        (s->length & (B2L_RO_STORE_PAGE - 1U)) != 0 ||
+        s->base < B2L_RO_STORE_BASE || s->base >= B2L_RO_STORE_END ||
+        s->length == 0 || s->length > B2L_RO_STORE_MAX_DIAGNOSTIC ||
+        s->length > B2L_RO_STORE_END - s->base ||
+        /* This v1 gate is pinned to the first witness/diagnostic interval. */
+        s->base != B2L_RO_STORE_BASE ||
+        (s->image_kind == B2L_RO_KIND_WITNESS &&
+         s->length != B2L_RO_STORE_PAGE) ||
+        (s->image_kind == B2L_RO_KIND_DIAGNOSTIC &&
+         s->length != B2L_RO_STORE_MAX_DIAGNOSTIC) ||
+        (s->image_kind != B2L_RO_KIND_WITNESS &&
+         s->image_kind != B2L_RO_KIND_DIAGNOSTIC)) return EINVAL;
+    /* [0x940...,0x9e0...) cannot intersect [0x900...,0x940...). */
+    if (s->base < B2L_RO_ARENA_END &&
+        s->length > B2L_RO_ARENA_BASE - s->base) return EINVAL;
+    for (unsigned i = 0; i < sizeof(s->image_sha256); ++i)
+        digest_or |= s->image_sha256[i];
+    return digest_or ? 0 : EINVAL;
+}
+
+int b2l_ro_store_disjoint_live(const struct b2l_ro_store *s,
+                               const struct b2l_ro_range *regions,
+                               size_t count)
+{
+    if (b2l_ro_store_geometry(s) || !regions ||
+        count != B2L_RO_LIVE_REGION_COUNT) return EINVAL;
+    for (size_t i = 0; i < count; ++i) {
+        uint64_t end;
+        if (regions[i].base == 0 || regions[i].length == 0 ||
+            regions[i].length > UINT64_MAX - regions[i].base) return EINVAL;
+        end = regions[i].base + regions[i].length;
+        if (s->base < end && regions[i].base < s->base + s->length)
+            return EINVAL;
+    }
+    return 0;
+}
+
+int b2l_ro_store_encode(uint8_t out[B2L_RO_STORE_V1_BYTES],
+                        const struct b2l_ro_store *s)
+{
+    if (!out || b2l_ro_store_geometry(s)) return EINVAL;
+    memset(out, 0, B2L_RO_STORE_V1_BYTES);
+    memcpy(out, magic, sizeof(magic));
+    put16(out + 8, 1);
+    put16(out + 10, B2L_RO_STORE_V1_BYTES);
+    put32(out + 12, B2L_RO_FLAGS);
+    put64(out + 16, s->base);
+    put64(out + 24, s->length);
+    put32(out + 32, B2L_RO_STORE_SECTOR);
+    put32(out + 36, s->image_kind);
+    memcpy(out + 40, s->image_sha256, 32);
+    put64(out + 72, s->reservation_tag);
+    return 0;
+}
+
+int b2l_ro_store_decode(const void *wire, size_t length,
+                        struct b2l_ro_store *out)
+{
+    struct b2l_ro_store s;
+    const uint8_t *p = wire;
+    if (!p || !out || length != B2L_RO_STORE_V1_BYTES ||
+        memcmp(p, magic, sizeof(magic)) != 0 ||
+        le16(p + 8) != 1 || le16(p + 10) != B2L_RO_STORE_V1_BYTES ||
+        le32(p + 12) != B2L_RO_FLAGS ||
+        le32(p + 32) != B2L_RO_STORE_SECTOR) return EINVAL;
+    s.base = le64(p + 16);
+    s.length = le64(p + 24);
+    s.image_kind = le32(p + 36);
+    memcpy(s.image_sha256, p + 40, 32);
+    s.reservation_tag = le64(p + 72);
+    if (b2l_ro_store_geometry(&s)) return EINVAL;
+    *out = s;
+    return 0;
+}
+
+int b2l_ro_store_span(const struct b2l_ro_store *s, uint64_t offset,
+                      size_t length, uint64_t *pa)
+{
+    if (!pa || b2l_ro_store_geometry(s) || length == 0 ||
+        (offset & (B2L_RO_STORE_SECTOR - 1U)) ||
+        (length & (B2L_RO_STORE_SECTOR - 1U)) ||
+        offset > s->length || length > s->length - offset) return EINVAL;
+    /* Geometry has proved base+length does not overflow. */
+    *pa = s->base + offset;
+    return 0;
+}
+
+int b2l_ro_store_open_flags(int fflags, int fwrite_mask)
+{ return (fflags & fwrite_mask) ? EROFS : 0; }
+int b2l_ro_store_block_operation(int is_read)
+{ return is_read ? 0 : EROFS; }
+int b2l_ro_store_char_write(void)
+{ return EROFS; }
+int b2l_ro_store_mutating_ioctl(void)
+{ return EROFS; }
diff -urN '--exclude=BUILD' '--exclude=.git' '--exclude=__pycache__' a/bsd/b2l_ro_store.h b/bsd/b2l_ro_store.h
--- a/bsd/b2l_ro_store.h	1970-01-01 09:00:00.000000000 +0900
+++ b/bsd/b2l_ro_store.h	2026-11-09 15:15:44.915591744 +0900
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef B2L_RO_STORE_H
+#define B2L_RO_STORE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* Explicit little-endian wire ABI, independent of C struct packing. */
+#define B2L_RO_STORE_V1_BYTES 80U
+#define B2L_RO_STORE_PAGE 4096U
+#define B2L_RO_STORE_SECTOR 512U
+#define B2L_RO_STORE_MAX_DIAGNOSTIC (1024U * 1024U)
+#define B2L_RO_STORE_BASE UINT64_C(0x940000000)
+#define B2L_RO_STORE_END  UINT64_C(0x9e0000000)
+#define B2L_RO_ARENA_BASE UINT64_C(0x900000000)
+#define B2L_RO_ARENA_END  UINT64_C(0x940000000)
+#define B2L_RO_FLAG_READ_ONLY 1U
+#define B2L_RO_FLAG_NO_EXEC   2U
+#define B2L_RO_FLAGS (B2L_RO_FLAG_READ_ONLY | B2L_RO_FLAG_NO_EXEC)
+#define B2L_RO_KIND_WITNESS 1U
+#define B2L_RO_KIND_DIAGNOSTIC 2U
+
+struct b2l_ro_store {
+    uint64_t base;
+    uint64_t length;
+    uint64_t reservation_tag;
+    uint32_t image_kind;
+    uint8_t image_sha256[32];
+};
+
+enum { B2L_RO_LIVE_REGION_COUNT = 6 };
+struct b2l_ro_range { uint64_t base, length; };
+
+/* Caller supplies EFI image/FD, stack, live FDT, USB stream, Upload snapshot,
+ * and framebuffer. All six must be present and disjoint from the image. */
+int b2l_ro_store_disjoint_live(const struct b2l_ro_store *store,
+                               const struct b2l_ro_range *regions,
+                               size_t region_count);
+
+/* Return 0 on acceptance. All other values are rejection. The digest is a
+ * claimed image identity; the caller must compare it with independently
+ * computed bytes before exposing a device. */
+int b2l_ro_store_encode(uint8_t out[B2L_RO_STORE_V1_BYTES],
+                        const struct b2l_ro_store *store);
+int b2l_ro_store_decode(const void *wire, size_t length,
+                        struct b2l_ro_store *out);
+int b2l_ro_store_geometry(const struct b2l_ro_store *store);
+
+/* A block request is sector-aligned and wholly within the image. Zero-length
+ * requests are rejected so no end-of-device ambiguity enters the driver. */
+int b2l_ro_store_span(const struct b2l_ro_store *store, uint64_t offset,
+                      size_t length, uint64_t *physical_address);
+
+/* Generic transport gates used by host tests and by the kernel adapter. */
+int b2l_ro_store_open_flags(int fflags, int fwrite_mask);
+int b2l_ro_store_block_operation(int is_read);
+int b2l_ro_store_char_write(void);
+int b2l_ro_store_mutating_ioctl(void);
+
+#endif
