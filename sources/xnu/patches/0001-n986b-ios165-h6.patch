diff -urN '--exclude=BUILD' '--exclude=.git' '--exclude=__pycache__' a/bsd/dev/B2LRoStoreDevice.c b/bsd/dev/B2LRoStoreDevice.c
--- a/bsd/dev/B2LRoStoreDevice.c	1970-01-01 09:00:00.000000000 +0900
+++ b/bsd/dev/B2LRoStoreDevice.c	2026-11-09 17:16:25.955832772 +0900
@@ -0,0 +1,563 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Host-only XNU 8796 adapter candidate. Deliberately absent from XNU build
+ * lists and from the known-good image. No md0 alias or root registration. */
+#include "../b2l_ro_device.h"
+#include <libkern/libkern.h>
+#include <libkern/crypto/sha2.h>
+#include <mach/mach_types.h>
+#include <miscfs/devfs/devfs.h>
+#include <pexpert/device_tree.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/uio.h>
+#include <sys/stat.h>
+#include <sys/vnode.h>
+#include <sys/vnode_if.h>
+#include <vm/pmap.h>
+
+extern void bcopy_phys(addr64_t from, addr64_t to, vm_size_t bytes);
+extern addr64_t kvtophys(vm_offset_t va);
+extern void mapping_set_mod(ppnum_t pn);
+
+static struct b2l_ro_device rodev;
+static int bmajor = -1, cmajor = -1;
+static void *bnode, *cnode;
+/* H5 is a one-shot pre-root physio/strategy diagnostic. It does not prove
+ * block vnode lookup or VNOP_STRATEGY; that is a separate later gate. */
+static struct {
+    unsigned active, calls, reads, writes;
+    uint64_t last_lba;
+    uint32_t last_count;
+    int last_flags, last_error;
+} h5_trace;
+static unsigned h5_probe_passed;
+/* H6 observes the vnode path separately from H5's physio path. Only the two
+ * audited edge reads may run while this receipt is armed. */
+static struct {
+    unsigned active, spec_calls, calls, reads, writes;
+    uint64_t last_lba;
+    uint32_t last_count;
+    int last_flags, last_error;
+    dev_t last_device, last_spec_device;
+} h6_trace;
+extern void loader_log_line(const char *line);
+
+static int
+ro_open(dev_t dev, int flags, __unused int type, __unused proc_t p)
+{
+    if (minor(dev) != 0 || !rodev.registered) return ENXIO;
+    return b2l_ro_store_open_flags(flags, FWRITE);
+}
+
+static int
+ro_close(__unused dev_t dev, __unused int flags, __unused int type,
+         __unused proc_t p)
+{ return 0; }
+
+/* Split both source and destination at 4 KiB physical boundaries before
+ * kvtophys(). XNU may advertise a larger VM page than this hardware uses. */
+static int
+ro_physical_read(__unused void *ctx, uint64_t source_pa,
+                 void *destination, size_t bytes)
+{
+    uintptr_t va = (uintptr_t)destination;
+    while (bytes) {
+        size_t dst_page_left = B2L_RO_STORE_PAGE - (va & (B2L_RO_STORE_PAGE - 1U));
+        size_t src_page_left = B2L_RO_STORE_PAGE - (source_pa & (B2L_RO_STORE_PAGE - 1U));
+        size_t n = bytes < dst_page_left ? bytes : dst_page_left;
+        if (n > src_page_left) n = src_page_left;
+        addr64_t dst_pa = kvtophys((vm_offset_t)va);
+        if (dst_pa == 0) return EFAULT;
+        bcopy_phys((addr64_t)source_pa, dst_pa, (vm_size_t)n);
+        mapping_set_mod((ppnum_t)(dst_pa >> 12));
+        source_pa += n;
+        va += n;
+        bytes -= n;
+    }
+    return 0;
+}
+
+
+static const uint8_t ro_first_sector_sha256[32] = {
+    0x1e,0x43,0x3d,0x6d,0x39,0x45,0x0e,0x64,
+    0x16,0x2e,0x55,0x81,0xfe,0x02,0x63,0x83,
+    0x09,0x22,0x58,0x7f,0xb6,0xb1,0xf2,0xa3,
+    0xb3,0xe6,0xda,0x3b,0xd0,0x51,0x52,0xf6
+};
+static const uint8_t ro_last_sector_sha256[32] = {
+    0xc3,0xff,0x82,0xd8,0xbe,0x95,0xb0,0xa7,
+    0x7b,0xc1,0xba,0x15,0x4c,0xce,0x41,0xc9,
+    0x88,0xb3,0x30,0xd8,0x3f,0x79,0x24,0x7c,
+    0xb0,0xc2,0xe4,0xa7,0x2a,0xb4,0xa4,0xda
+};
+
+/* Exercise the actual bcopy_phys source window before publishing /dev.
+ * This is bounded to the two 512-byte edge sectors and is not a root read. */
+static int
+ro_probe_edges(struct b2l_ro_device *candidate)
+{
+    struct {
+        uint64_t before;
+        uint8_t bytes[B2L_RO_STORE_SECTOR];
+        uint64_t after;
+    } probe;
+    uint8_t digest[32];
+    SHA256_CTX ctx;
+    const uint64_t offsets[2] = {
+        0, B2L_RO_STORE_MAX_DIAGNOSTIC - B2L_RO_STORE_SECTOR
+    };
+    const uint8_t *pins[2] = { ro_first_sector_sha256, ro_last_sector_sha256 };
+    for (unsigned edge = 0; edge < 2; ++edge) {
+        probe.before = 0xb2a4c1d2e3f40123ULL;
+        probe.after = 0x3276a4d1e2f39905ULL;
+        memset(probe.bytes, 0xa5, sizeof(probe.bytes));
+        int error = b2l_ro_device_read(candidate, offsets[edge], probe.bytes,
+                                       sizeof(probe.bytes), ro_physical_read, NULL);
+        if (error) return error;
+        if (probe.before != 0xb2a4c1d2e3f40123ULL ||
+            probe.after != 0x3276a4d1e2f39905ULL) return EIO;
+        SHA256_Init(&ctx);
+        SHA256_Update(&ctx, probe.bytes, sizeof(probe.bytes));
+        SHA256_Final(digest, &ctx);
+        if (memcmp(digest, pins[edge], sizeof(digest)) != 0) return EIO;
+    }
+    return 0;
+}
+
+static void
+ro_strategy(buf_t bp)
+{
+    int error = 0;
+    caddr_t va = NULL;
+    uint64_t sector;
+    size_t length = buf_count(bp);
+    if (h5_trace.active) {
+        h5_trace.calls++;
+        if (buf_flags(bp) & B_READ) h5_trace.reads++;
+        else h5_trace.writes++;
+        h5_trace.last_lba = (uint64_t)buf_blkno(bp);
+        h5_trace.last_count = (uint32_t)length;
+        h5_trace.last_flags = (int)buf_flags(bp);
+    }
+    if (h6_trace.active) {
+        h6_trace.calls++;
+        if (buf_flags(bp) & B_READ) h6_trace.reads++;
+        else h6_trace.writes++;
+        h6_trace.last_lba = (uint64_t)buf_blkno(bp);
+        h6_trace.last_count = (uint32_t)length;
+        h6_trace.last_flags = (int)buf_flags(bp);
+        h6_trace.last_device = buf_device(bp);
+    }
+    buf_setresid(bp, (uint32_t)length);
+    if (!rodev.registered || minor(buf_device(bp)) != 0) {
+        error = ENXIO;
+    } else if ((error = b2l_ro_store_block_operation((buf_flags(bp) & B_READ) != 0)) != 0) {
+        /* This guard is before buf_map and before any physical operation. */
+    } else if (buf_blkno(bp) < 0 || length == 0) {
+        error = EINVAL;
+    } else {
+        sector = (uint64_t)buf_blkno(bp);
+        if (sector > UINT64_MAX / B2L_RO_STORE_SECTOR ||
+            b2l_ro_store_span(&rodev.store,
+                              sector * B2L_RO_STORE_SECTOR,
+                              length, &sector) != 0) {
+            error = EINVAL;
+        } else if (buf_map(bp, &va) != 0) {
+            error = EFAULT;
+        } else {
+            /* span returns a PA only as validation; read recalculates from
+             * the validated sector offset and bounds each copy to a page. */
+            error = b2l_ro_device_read(&rodev,
+                                       (uint64_t)buf_blkno(bp) * B2L_RO_STORE_SECTOR,
+                                       va, length, ro_physical_read, NULL);
+            buf_unmap(bp);
+        }
+    }
+    if (h5_trace.active) h5_trace.last_error = error;
+    if (h6_trace.active) h6_trace.last_error = error;
+    if (error) buf_seterror(bp, error);
+    else buf_setresid(bp, 0);
+    buf_biodone(bp);
+}
+
+static int
+ro_ioctl(dev_t dev, u_long cmd, caddr_t data,
+         __unused int flags, __unused proc_t p)
+{
+    uint64_t v;
+    if (!rodev.registered || minor(dev) != 0) return ENXIO;
+    if (!data) return EROFS;
+    switch (cmd) {
+    case DKIOCGETBLOCKSIZE:
+        *(uint32_t *)data = B2L_RO_STORE_SECTOR; return 0;
+    case DKIOCGETPHYSICALBLOCKSIZE:
+        *(uint32_t *)data = B2L_RO_STORE_PAGE; return 0;
+    case DKIOCGETBLOCKCOUNT:
+        b2l_ro_device_query(&rodev, B2L_RO_QUERY_BLOCK_COUNT, &v);
+        *(uint64_t *)data = v; return 0;
+    case DKIOCISWRITABLE:
+        *(uint32_t *)data = 0; return 0;
+    case DKIOCGETMAXBLOCKCOUNTREAD:
+        b2l_ro_device_query(&rodev, B2L_RO_QUERY_MAX_READ_BLOCKS, &v);
+        *(uint64_t *)data = v; return 0;
+    case DKIOCGETMAXBLOCKCOUNTWRITE:
+        *(uint64_t *)data = 0; return 0;
+    case DKIOCSETBLOCKSIZE:
+        /* spec_open probes 512 without changing this immutable geometry. */
+        return *(uint32_t *)data == B2L_RO_STORE_SECTOR ? 0 : EROFS;
+    default:
+        return b2l_ro_store_mutating_ioctl();
+    }
+}
+
+static int
+ro_size(dev_t dev)
+{ return rodev.registered && minor(dev) == 0 ? B2L_RO_STORE_SECTOR : -1; }
+
+static int
+ro_char_read(dev_t dev, struct uio *uio, __unused int flags)
+{
+    if (!rodev.registered || minor(dev) != 0) return ENXIO;
+    return physio(ro_strategy, NULL, dev, B_READ, minphys, uio,
+                  B2L_RO_STORE_SECTOR);
+}
+
+static int
+ro_char_write(__unused dev_t dev, __unused struct uio *uio,
+              __unused int flags)
+{ return b2l_ro_store_char_write(); }
+
+static const struct bdevsw ro_bdevsw = {
+    .d_open = ro_open, .d_close = ro_close, .d_strategy = ro_strategy,
+    .d_ioctl = ro_ioctl, .d_dump = eno_dump, .d_psize = ro_size,
+    .d_type = D_DISK,
+};
+static const struct cdevsw ro_cdevsw = {
+    .d_open = ro_open, .d_close = ro_close, .d_read = ro_char_read,
+    .d_write = ro_char_write, .d_ioctl = ro_ioctl,
+    .d_stop = eno_stop, .d_reset = eno_reset, .d_ttys = NULL,
+    .d_select = eno_select, .d_mmap = eno_mmap, .d_strategy = eno_strat,
+    .d_reserved_1 = eno_getc, .d_reserved_2 = eno_putc, .d_type = D_DISK,
+};
+
+/* H5 runs immediately after H4b registration, before root mount. The
+ * diagnostic root on this device does not mount, so a post-/dev hook would
+ * never execute. ro_char_read uses the in-tree physio implementation with
+ * B_READ and a kernel-space UIO, then calls the registered ro_strategy.
+ * This is a driver strategy callback gate, NOT a block vnode/VNOP gate. */
+static int
+h5_reject(const char *step, int error)
+{
+    char line[128];
+    snprintf(line, sizeof(line), "B2L-H5-REJECT step=%s errno=%d\n", step, error);
+    loader_log_line(line);
+    return error ? error : EIO;
+}
+
+static int
+h5_read_sector(uint64_t lba, const uint8_t pin[32])
+{
+    struct {
+        uint64_t before;
+        uint8_t bytes[B2L_RO_STORE_SECTOR];
+        uint64_t after;
+    } guarded;
+    uint8_t digest[32];
+    SHA256_CTX sha;
+    uio_t uio;
+    unsigned prior_calls = h5_trace.calls;
+    unsigned prior_reads = h5_trace.reads;
+    user_ssize_t residual;
+    int error;
+
+    guarded.before = 0xb205a1c2d3e4f611ULL;
+    guarded.after = 0x116f4e3d2c1a50b2ULL;
+    memset(guarded.bytes, 0xa5, sizeof(guarded.bytes));
+    uio = uio_create(1, (off_t)(lba * B2L_RO_STORE_SECTOR),
+                     UIO_SYSSPACE, UIO_READ);
+    if (uio == NULL) return h5_reject("uio-create", ENOMEM);
+    error = uio_addiov(uio, (user_addr_t)(uintptr_t)guarded.bytes,
+                       B2L_RO_STORE_SECTOR);
+    if (error) {
+        uio_free(uio);
+        return h5_reject("uio-addiov", error);
+    }
+    error = ro_char_read(makedev(cmajor, 0), uio, 0);
+    residual = uio_resid(uio);
+    uio_free(uio);
+    if (error || residual != 0)
+        return h5_reject("physio-read", error ? error : EIO);
+    if (guarded.before != 0xb205a1c2d3e4f611ULL ||
+        guarded.after != 0x116f4e3d2c1a50b2ULL)
+        return h5_reject("canary", EIO);
+    SHA256_Init(&sha);
+    SHA256_Update(&sha, guarded.bytes, sizeof(guarded.bytes));
+    SHA256_Final(digest, &sha);
+    if (memcmp(digest, pin, sizeof(digest)) != 0)
+        return h5_reject("sha256", EIO);
+    if (h5_trace.calls != prior_calls + 1 ||
+        h5_trace.reads != prior_reads + 1 ||
+        h5_trace.writes != 0 || h5_trace.last_lba != lba ||
+        h5_trace.last_count != B2L_RO_STORE_SECTOR ||
+        (h5_trace.last_flags & (B_READ | B_PHYS | B_RAW)) !=
+            (B_READ | B_PHYS | B_RAW) || h5_trace.last_error != 0)
+        return h5_reject("strategy-receipt", EIO);
+    if (lba == 0)
+        loader_log_line("B2L-H5-LBA0-CALLBACK-PASS sha256=1e433d6d39450e64162e5581fe0263830922587fb6b1f2a3b3e6da3bd05152f6\n");
+    else
+        loader_log_line("B2L-H5-LBA2047-CALLBACK-PASS sha256=c3ff82d8be95b0a77bc1ba154cce41c988b330d83f79247cb0c2e4a72ab4a4da\n");
+    return 0;
+}
+
+static void
+h5_probe_strategy_callback(void)
+{
+    loader_log_line("B2L-H5-ENTER pre-root char-physio\n");
+    if (!rodev.registered || cmajor < 0) {
+        h5_reject("registration-absent", ENXIO);
+        return;
+    }
+    memset(&h5_trace, 0, sizeof(h5_trace));
+    h5_trace.active = 1;
+    if (h5_read_sector(0, ro_first_sector_sha256) != 0) goto done;
+    if (h5_read_sector(2047, ro_last_sector_sha256) != 0) goto done;
+    if (h5_trace.calls != 2 || h5_trace.reads != 2 || h5_trace.writes != 0) {
+        h5_reject("no-write-counter", EIO);
+        goto done;
+    }
+    loader_log_line("B2L-H5-NO-WRITE calls=2 reads=2 writes=0\n");
+    loader_log_line("B2L-H5-PASS char-physio-strategy-only no-vnode no-root-alias\n");
+    h5_probe_passed = 1;
+done:
+    h5_trace.active = 0;
+}
+
+
+/* Called by spec_strategy immediately before dispatch to bdevsw.d_strategy.
+ * This is receipt-only instrumentation, never an I/O operation. */
+void
+b2l_ro_store_h6_spec_enter(dev_t dev)
+{
+    if (h6_trace.active && dev == makedev(bmajor, 0)) {
+        h6_trace.spec_calls++;
+        h6_trace.last_spec_device = dev;
+    }
+}
+
+static int
+h6_reject(const char *step, int error)
+{
+    char line[128];
+    snprintf(line, sizeof(line), "B2L-H6-REJECT step=%s errno=%d\n", step, error);
+    loader_log_line(line);
+    return error ? error : EIO;
+}
+
+/* This is a raw iobuf through a real VBLK vnode, not a direct call to
+ * ro_strategy and not a buffer-cache or root-filesystem read. The sequence
+ * follows the in-tree wdev_io pattern in bsd/dev/hakios.apfs_check.c. */
+static int
+h6_read_vblk_sector(vnode_t vp, uint64_t lba, const uint8_t pin[32])
+{
+    struct {
+        uint64_t before;
+        uint8_t bytes[B2L_RO_STORE_SECTOR];
+        uint64_t after;
+    } guarded;
+    SHA256_CTX sha;
+    uint8_t digest[32];
+    buf_t bp;
+    unsigned prior_calls = h6_trace.calls;
+    unsigned prior_spec_calls = h6_trace.spec_calls;
+    int error;
+
+    guarded.before = 0xb206a1c2d3e4f711ULL;
+    guarded.after = 0x117f4e3d2c1a60b2ULL;
+    memset(guarded.bytes, 0xa5, sizeof(guarded.bytes));
+    bp = buf_alloc(vp);
+    if (bp == NULL) return h6_reject("buf-alloc", ENOMEM);
+    buf_reset(bp, B_READ);
+    buf_setblkno(bp, (daddr64_t)lba);
+    buf_setlblkno(bp, (daddr64_t)lba);
+    buf_setcount(bp, B2L_RO_STORE_SECTOR);
+    buf_setdataptr(bp, (uintptr_t)guarded.bytes);
+    error = VNOP_STRATEGY(bp);
+    if (error == 0) error = (int)buf_biowait(bp);
+    if (error == 0 && (buf_resid(bp) != 0 ||
+                       buf_count(bp) != B2L_RO_STORE_SECTOR)) error = EIO;
+    buf_free(bp);
+    if (error) return h6_reject("vnop-strategy", error);
+    if (guarded.before != 0xb206a1c2d3e4f711ULL ||
+        guarded.after != 0x117f4e3d2c1a60b2ULL)
+        return h6_reject("canary", EIO);
+    SHA256_Init(&sha);
+    SHA256_Update(&sha, guarded.bytes, sizeof(guarded.bytes));
+    SHA256_Final(digest, &sha);
+    if (memcmp(digest, pin, sizeof(digest)) != 0)
+        return h6_reject("sha256", EIO);
+    if (h6_trace.spec_calls != prior_spec_calls + 1 ||
+        h6_trace.calls != prior_calls + 1 ||
+        h6_trace.reads != h6_trace.calls || h6_trace.writes != 0 ||
+        h6_trace.last_lba != lba ||
+        h6_trace.last_count != B2L_RO_STORE_SECTOR ||
+        h6_trace.last_device != makedev(bmajor, 0) ||
+        h6_trace.last_spec_device != makedev(bmajor, 0) ||
+        (h6_trace.last_flags & B_READ) == 0 || h6_trace.last_error != 0)
+        return h6_reject("specfs-strategy-receipt", EIO);
+    if (lba == 0)
+        loader_log_line("B2L-H6-LBA0-VNOP-PASS sha256=1e433d6d39450e64162e5581fe0263830922587fb6b1f2a3b3e6da3bd05152f6\n");
+    else
+        loader_log_line("B2L-H6-LBA2047-VNOP-PASS sha256=c3ff82d8be95b0a77bc1ba154cce41c988b330d83f79247cb0c2e4a72ab4a4da\n");
+    return 0;
+}
+
+static void
+h6_probe_vblk_vnop(void)
+{
+    vnode_t vp = NULLVP;
+    vfs_context_t context;
+    dev_t dev;
+    uint32_t block_size = B2L_RO_STORE_SECTOR;
+    uint64_t block_count = 0;
+    int error;
+    int reads_passed = 0;
+
+    loader_log_line("B2L-H6-ENTER pre-root vblk-vnop-strategy\n");
+    if (!h5_probe_passed || !rodev.registered || bmajor < 0 || cmajor < 0) {
+        h6_reject("h5-or-registration-absent", ENXIO);
+        return;
+    }
+    /* bdevvp internally panics on OPEN failure. Reject known causes before
+     * constructing its vnode. The H4b core already pins diagnostic geometry,
+     * but repeat the immutable 512/2048 and FREAD/ioctl checks at this gate. */
+    dev = makedev(bmajor, 0);
+    if (b2l_ro_store_geometry(&rodev.store) != 0 ||
+        rodev.store.image_kind != B2L_RO_KIND_DIAGNOSTIC ||
+        rodev.store.base != B2L_RO_STORE_BASE ||
+        rodev.store.length != B2L_RO_STORE_MAX_DIAGNOSTIC ||
+        b2l_ro_store_block_operation(0) != EROFS ||
+        ro_open(dev, FREAD, S_IFBLK, NULL) != 0 ||
+        ro_ioctl(dev, DKIOCGETBLOCKSIZE, (caddr_t)&block_size, 0, NULL) != 0 ||
+        block_size != B2L_RO_STORE_SECTOR ||
+        ro_ioctl(dev, DKIOCSETBLOCKSIZE, (caddr_t)&block_size, FWRITE, NULL) != 0 ||
+        ro_ioctl(dev, DKIOCGETBLOCKCOUNT, (caddr_t)&block_count, 0, NULL) != 0 ||
+        block_count != 2048 ||
+        ro_ioctl(dev, DKIOCSETBLOCKSIZE, (caddr_t)&block_size, FWRITE, NULL) != 0) {
+        h6_reject("bdevvp-preflight", EINVAL);
+        return;
+    }
+    loader_log_line("B2L-H6-PREFLIGHT geometry=512x2048 fread=1 set512x2=1\n");
+    /* bdevvp is the canonical XNU pre-root constructor used by
+     * vfs_mountroot. It may panic internally if fsync/invalidate/open fail;
+     * H5 success and the immutable geometry gate are preconditions here. */
+    error = bdevvp(dev, &vp);
+    if (error || vp == NULLVP) {
+        h6_reject("bdevvp", error ? error : EIO);
+        return;
+    }
+    loader_log_line("B2L-H6-BDEVVP-PASS vblk-open-fread\n");
+    context = vfs_context_kernel();
+    memset(&h6_trace, 0, sizeof(h6_trace));
+    h6_trace.active = 1;
+    if (h6_read_vblk_sector(vp, 0, ro_first_sector_sha256) != 0) goto done;
+    if (h6_read_vblk_sector(vp, 2047, ro_last_sector_sha256) != 0) goto done;
+    if (h6_trace.spec_calls != 2 || h6_trace.calls != 2 ||
+        h6_trace.reads != 2 || h6_trace.writes != 0) {
+        h6_reject("no-write-counter", EIO);
+        goto done;
+    }
+    loader_log_line("B2L-H6-NO-WRITE spec=2 calls=2 reads=2 writes=0\n");
+    reads_passed = 1;
+done:
+    h6_trace.active = 0;
+    error = VNOP_CLOSE(vp, FREAD, context);
+    if (error) h6_reject("vnop-close", error);
+    vnode_rele(vp);
+    vnode_put(vp);
+    loader_log_line("B2L-H6-CLEANUP vnode-rele-put\n");
+    if (reads_passed && error == 0)
+        loader_log_line("B2L-H6-PASS vblk-vnop-specfs-strategy no-root-alias\n");
+}
+
+/* Called once by the H4 early probe only after a v3 UEFI receipt, live DT
+ * match, full 1 MiB physical digest and read-only copy-window check. The
+ * first/last 512-byte bcopy probe must also pass before devfs publication. */
+int
+b2l_ro_store_xnu_register_verified(const struct b2l_ro_proof *proof)
+{
+    DTEntry chosen;
+    void const *property;
+    unsigned int length;
+    struct b2l_ro_device candidate;
+    char line[128];
+    int rc;
+    if (rodev.registered) return EALREADY;
+    /* SecureDT functions return kSuccess=1, not 0. The H4 gate rejected
+     * a successful lookup before its core or edge checks could run. */
+    rc = SecureDTLookupEntry(0, "/chosen", &chosen);
+    if (rc != kSuccess) {
+        snprintf(line, sizeof(line), "B2L-H4B-DT-LOOKUP-REJECT rc=%d\n", rc);
+        loader_log_line(line);
+        return EINVAL;
+    }
+    rc = SecureDTGetProperty(chosen, "b2l,ro-store-v1", &property, &length);
+    if (rc != kSuccess) {
+        snprintf(line, sizeof(line), "B2L-H4B-DT-PROP-REJECT rc=%d\n", rc);
+        loader_log_line(line);
+        return EINVAL;
+    }
+    rc = b2l_ro_device_init(&candidate, property, length, proof);
+    if (rc != 0) {
+        snprintf(line, sizeof(line),
+                 "B2L-H4B-CORE-REJECT rc=%d length=%u\n", rc, length);
+        loader_log_line(line);
+        return rc;
+    }
+    loader_log_line("B2L-H4B-DT-CORE-PASS\n");
+    /* The DT and full-physical proof are accepted by the core first.
+     * A bcopy_phys edge failure must leave no published device. */
+    int probe_error = ro_probe_edges(&candidate);
+    if (probe_error) {
+        loader_log_line("B2L-H4-BCOPY-EDGE-REJECT\n");
+        return probe_error;
+    }
+    loader_log_line("B2L-H4-BCOPY-EDGE-PASS first=1e433d6d39450e64162e5581fe0263830922587fb6b1f2a3b3e6da3bd05152f6 last=c3ff82d8be95b0a77bc1ba154cce41c988b330d83f79247cb0c2e4a72ab4a4da\n");
+    if (b2l_ro_store_block_operation(0) != EROFS ||
+        b2l_ro_store_char_write() != EROFS ||
+        b2l_ro_store_mutating_ioctl() != EROFS) return EIO;
+    loader_log_line("B2L-H4-WRITE-GATES-PASS\n");
+    bmajor = bdevsw_add(-1, &ro_bdevsw);
+    if (bmajor < 0) return ENOSPC;
+    cmajor = cdevsw_add_with_bdev(-1, &ro_cdevsw, bmajor);
+    if (cmajor < 0) {
+        bdevsw_remove(bmajor, &ro_bdevsw);
+        bmajor = -1;
+        return ENOSPC;
+    }
+    rodev = candidate;
+    bnode = devfs_make_node(makedev(bmajor, 0), DEVFS_BLOCK,
+                            UID_ROOT, GID_OPERATOR, 0440, "b2lro0");
+    cnode = devfs_make_node(makedev(cmajor, 0), DEVFS_CHAR,
+                            UID_ROOT, GID_OPERATOR, 0440, "rb2lro0");
+    if (!bnode || !cnode) {
+        if (bnode) devfs_remove(bnode);
+        if (cnode) devfs_remove(cnode);
+        rodev.registered = 0;
+        cdevsw_remove(cmajor, &ro_cdevsw);
+        bdevsw_remove(bmajor, &ro_bdevsw);
+        cmajor = bmajor = -1;
+        return ENOMEM;
+    }
+    snprintf(line, sizeof(line),
+             "B2L-H4-REGISTER-OK b2lro0=%d rb2lro0=%d sectors=2048\n",
+             bmajor, cmajor);
+    loader_log_line(line);
+    h5_probe_strategy_callback();
+    h6_probe_vblk_vnop();
+    return 0;
+}
