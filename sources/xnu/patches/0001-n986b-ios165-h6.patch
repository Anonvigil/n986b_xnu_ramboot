+/* The low manifest is v3; its 80-byte /chosen RO record remains ABI v1.
+ * This function checks the live manifest against the live DT, and the UEFI
+ * post-reservation/prebranch receipts against the same manifest and nonce.
+ * It does not infer ownership from a DT assertion by itself. */
+static uint8_t
+b2l_h4_phys_byte(uint64_t pa)
+{
+    uint64_t value = ml_phys_read_double_64(pa & ~7ULL);
+    return (uint8_t)(value >> ((pa & 7ULL) * 8));
+}
+
+static bool
+b2l_h4_phys_equals(uint64_t pa, const uint8_t *expected, unsigned length)
+{
+    for (unsigned i = 0; i < length; ++i) {
+        if (b2l_h4_phys_byte(pa + i) != expected[i]) return false;
+    }
+    return true;
+}
+
+static void
+b2l_h4_phys_sha256(uint64_t pa, unsigned length, uint8_t digest[32])
+{
+    SHA256_CTX ctx;
+    uint8_t lane[8];
+    SHA256_Init(&ctx);
+    for (unsigned offset = 0; offset < length; offset += 8) {
+        uint64_t value = ml_phys_read_double_64(pa + offset);
+        for (unsigned j = 0; j < 8; ++j) lane[j] = (uint8_t)(value >> (j * 8));
+        SHA256_Update(&ctx, lane, 8);
+    }
+    SHA256_Final(digest, &ctx);
+}
