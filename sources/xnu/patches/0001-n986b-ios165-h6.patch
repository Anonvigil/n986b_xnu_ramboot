+static bool
+b2l_h4_verify_v3_receipt(const uint8_t dt_record[80], uint64_t tag)
+{
+    static const uint8_t manifest_magic[8] = { 'N','9','8','6','B','X','N','U' };
+    static const uint8_t snapshot_magic[8] = { 'N','9','8','6','B','X','H','S' };
+    const uint64_t manifest = 0x90700000ULL;
+    const uint64_t marker = 0x95e00000ULL;
+    const uint64_t snapshot = 0x95d00000ULL;
+    uint8_t manifest_sha[32];
+    if (!b2l_h4_phys_equals(manifest, manifest_magic, 8) ||
+        ml_phys_read_double_64(manifest + 8) != ((uint64_t)4096 << 32 | 3) ||
+        !b2l_h4_phys_equals(manifest + 380, dt_record, 80) ||
+        !b2l_h4_phys_equals(snapshot, snapshot_magic, 8) ||
+        ml_phys_read_double_64(snapshot + 8) != ((uint64_t)856 << 32 | 3) ||
+        ml_phys_read_double_64(snapshot + 16) != 0x30 ||
+        ml_phys_read_double_64(snapshot + 24) != 0 ||
+        ml_phys_read_double_64(marker + 0x860) != 11 ||
+        ml_phys_read_double_64(marker + 0x910) != 0x986b0011ULL ||
+        ml_phys_read_double_64(marker + 0x918) != 0x986b1650ULL ||
+        ml_phys_read_double_64(marker + 0x920) != 0x940000000ULL ||
+        ml_phys_read_double_64(marker + 0x928) != 0xa0000000ULL ||
+        ml_phys_read_double_64(marker + 0x930) != 1 ||
+        ml_phys_read_double_64(marker + 0x938) != 1 ||
+        ml_phys_read_double_64(marker + 0x940) != tag ||
+        ml_phys_read_double_64(marker + 0x968) != 1 ||
+        !b2l_h4_phys_equals(marker + 0x948, b2l_h4_expected_sha256, 32)) {
+        return false;
+    }
+    b2l_h4_phys_sha256(manifest, 4096, manifest_sha);
+    return b2l_h4_phys_equals(marker + 0x8f0, manifest_sha, 32) &&
+           b2l_h4_phys_equals(snapshot + 824, manifest_sha, 32);
